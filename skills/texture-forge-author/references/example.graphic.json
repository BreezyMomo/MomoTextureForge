{
  "schema": "momo.graphic-authoring/v1",
  "name": "呼吸圆环",
  "category": "我的图形",
  "description": "速度控制每秒呼吸次数；time 持续累加。",
  "formula": {
    "kind": "body",
    "source": "float radius = baseRadius + sin(time * TAU * speed) * amplitude;\nreturn line(length(q)-radius, thickness, softness);"
  },
  "parameters": [
    {
      "variable": "baseRadius",
      "label": "半径",
      "min": 0.1,
      "max": 0.85,
      "step": 0.01,
      "default": 0.5
    },
    {
      "variable": "thickness",
      "label": "线宽",
      "min": 0.005,
      "max": 0.2,
      "step": 0.005,
      "default": 0.04
    },
    {
      "variable": "softness",
      "label": "柔化",
      "min": 0.001,
      "max": 0.1,
      "step": 0.001,
      "default": 0.01
    },
    {
      "variable": "speed",
      "label": "速度",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    {
      "variable": "amplitude",
      "label": "幅度",
      "min": 0,
      "max": 0.1,
      "step": 0.005,
      "default": 0.05
    }
  ],
  "helpers": ""
}
